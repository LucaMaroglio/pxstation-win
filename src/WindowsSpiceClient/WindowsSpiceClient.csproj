<Project Sdk="Microsoft.NET.Sdk">
  <!--
    App WinUI 3 non pacchettizzata (decisione §7.1 del piano): eseguibile autonomo con icona,
    Windows App SDK incluso (nessun runtime da installare), distribuito con Inno Setup.
    Windows minimo: 10 22H2 (build 19045); si dichiara 19041, il minimo del Windows App SDK
    su cui la 22H2 si basa.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>WindowsSpiceClient</RootNamespace>
    <AssemblyName>WindowsSpiceClient</AssemblyName>
    <AssemblyTitle>Windows Spice Client</AssemblyTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Testi in Strings\it-IT\Resources.resw: l'italiano è anche la lingua di riserva. -->
    <DefaultLanguage>it-IT</DefaultLanguage>
    <!-- Main in Program.cs: l'istanza unica va decisa prima di creare l'app. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Display\Shaders\*.hlsl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpiceKit\SpiceKit.csproj" />
    <ProjectReference Include="..\SpiceKit.Windows\SpiceKit.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>
</Project>
