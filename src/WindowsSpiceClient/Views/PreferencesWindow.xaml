<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsSpiceClient.Views.PreferencesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsSpiceClient.Views">

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- Scheda in stile Impostazioni di Windows 11. -->
            <Style x:Key="CardStyle" TargetType="Grid">
                <Setter Property="Padding" Value="16,12,16,12" />
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="ColumnSpacing" Value="16" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            </Style>
            <Style x:Key="GroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,20,0,6" />
            </Style>
            <Style x:Key="NoteStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" x:Uid="PreferencesTitleBar" Title="Preferenze">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/app-64.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="200"
                        SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GeneralItem" x:Uid="GeneralPageItem" Tag="general" Icon="Setting" />
                <NavigationViewItem x:Name="ProxmoxItem" x:Uid="ProxmoxPageItem" Tag="proxmox">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <!-- Generale -->
                <ScrollViewer x:Name="GeneralPage" Padding="24,0,24,24">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Spacing="3">
                        <TextBlock x:Uid="GeneralPageTitle" Style="{StaticResource TitleTextBlockStyle}" Margin="0,12,0,0" />

                        <TextBlock x:Uid="GroupConnection" Style="{StaticResource GroupHeaderStyle}" />
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ReconnectTitleText" x:Uid="ReconnectTitle" TextWrapping="Wrap" />
                                <TextBlock x:Uid="ReconnectNote" Style="{StaticResource NoteStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ReconnectSwitch" AutomationProperties.LabeledBy="{Binding ElementName=ReconnectTitleText}" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                          Toggled="OnSettingToggled" />
                        </Grid>

                        <TextBlock x:Uid="GroupDisplay" Style="{StaticResource GroupHeaderStyle}" />
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="FullScreenTitleText" x:Uid="FullScreenTitle" TextWrapping="Wrap" />
                                <TextBlock x:Uid="FullScreenNote" Style="{StaticResource NoteStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="FullScreenSwitch" AutomationProperties.LabeledBy="{Binding ElementName=FullScreenTitleText}" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                          Toggled="OnSettingToggled" />
                        </Grid>

                        <TextBlock x:Uid="GroupDesktop" Style="{StaticResource GroupHeaderStyle}" />
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TrayTitleText" x:Uid="TrayTitle" TextWrapping="Wrap" />
                                <TextBlock x:Uid="TrayNote" Style="{StaticResource NoteStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TraySwitch" AutomationProperties.LabeledBy="{Binding ElementName=TrayTitleText}" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                          Toggled="OnSettingToggled" />
                        </Grid>
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NotificationsTitleText" x:Uid="NotificationsTitle" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="NotificationsSwitch" AutomationProperties.LabeledBy="{Binding ElementName=NotificationsTitleText}" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                          Toggled="OnSettingToggled" />
                        </Grid>

                        <TextBlock x:Uid="GroupVVFiles" Style="{StaticResource GroupHeaderStyle}" />
                        <Grid Style="{StaticResource CardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AssociationText" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button x:Name="AssociationButton" x:Uid="UseThisProgramButton" Grid.Column="1" VerticalAlignment="Center"
                                    Click="OnMakeDefault" />
                        </Grid>
                        <TextBlock x:Uid="VVFootnote" Style="{StaticResource NoteStyle}" Margin="2,6,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Proxmox -->
                <Grid x:Name="ProxmoxPage" Padding="24,0,24,24" Visibility="Collapsed" RowSpacing="12" MaxWidth="808" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="ProxmoxPageTitle" Style="{StaticResource TitleTextBlockStyle}" Margin="0,12,0,0" />
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                              CornerRadius="{StaticResource OverlayCornerRadius}">
                            <ListView x:Name="ServerList" SelectionMode="Single" IsItemClickEnabled="False" Padding="0,4,0,4"
                                      SelectionChanged="OnServerSelectionChanged" DoubleTapped="OnServerDoubleTapped">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ServerItem">
                                        <Grid ColumnSpacing="12" Padding="0,8,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE968;" FontSize="20" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="NoServersText" x:Uid="NoServersInList" Margin="16" Visibility="Collapsed"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="8" MinWidth="128">
                            <Button x:Uid="AddServerButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="OnAddServer" />
                            <Button x:Name="EditServerButton" x:Uid="EditServerButton" HorizontalAlignment="Stretch" Click="OnEditServer" />
                            <Button x:Name="RemoveServerButton" x:Uid="RemoveServerButton" HorizontalAlignment="Stretch" Click="OnRemoveServer" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Uid="ServersFootnote" Grid.Row="2" Style="{StaticResource NoteStyle}" />
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
