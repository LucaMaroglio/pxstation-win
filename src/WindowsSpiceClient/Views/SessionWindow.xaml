<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsSpiceClient.Views.SessionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:display="using:WindowsSpiceClient.Display">

    <Grid x:Name="Root" Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="SPICE">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/app-64.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <!-- Comandi della sessione (M4): le scorciatoie mostrate sono quelle del .vv o le predefinite. -->
                <Button x:Name="SessionMenuButton" x:Uid="SessionMenuButton" Margin="0,0,4,0" IsEnabled="False"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE765;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="SessionMenu" Placement="BottomEdgeAlignedRight" Opening="OnSessionMenuOpening">
                            <MenuFlyoutItem x:Name="SecureAttentionItem" x:Uid="SessionSendCtrlAltDel" Click="OnSecureAttention">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="FullscreenItem" x:Uid="SessionToggleFullscreen" Click="OnToggleFullscreen">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ReleaseCursorItem" x:Uid="SessionReleaseCursor" Click="OnReleaseCursor">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B0;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <!-- Microfono (M7): spento in ogni sessione finché l'utente non lo accende. -->
                            <ToggleMenuFlyoutItem x:Name="MicrophoneItem" x:Uid="SessionMicrophone" IsEnabled="False" Click="OnToggleMicrophone">
                                <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE720;" /></ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <!-- Dispositivi (M8): ISO come CD-ROM USB, smartcard del PC. -->
                            <MenuFlyoutItem x:Name="MountIsoItem" x:Uid="SessionMountIso" Click="OnMountIso">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE958;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="EjectIsoItem" Visibility="Collapsed" Click="OnEjectIso">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF847;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="SmartcardMenu" x:Uid="SessionSmartcardMenu">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8C7;" /></MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- Stato della connessione SPICE (M2); il riepilogo del profilo resta sotto il titolo. -->
        <InfoBar x:Name="ProfileInfo" Grid.Row="1" Margin="12,0,12,8" IsOpen="True" IsClosable="False"
                 Severity="Informational">
            <InfoBar.Content>
                <ProgressBar x:Name="ConnectingProgress" IsIndeterminate="True" Margin="0,0,0,12" />
            </InfoBar.Content>
        </InfoBar>

        <!-- Schermo della VM (Direct3D 11): adattato al pannello mantenendo le proporzioni, bordi neri.
             Sopra, il cursore dell'ospite in modalità server (in modalità client è il cursore di sistema). -->
        <Border Grid.Row="2" Background="Black">
            <Grid>
                <display:DisplaySurface x:Name="DisplayPanel" x:Uid="DisplayPanel" IsTabStop="True" AllowDrop="True"
                                        DragOver="OnDragOver" Drop="OnDrop" />
                <Canvas IsHitTestVisible="False">
                    <Image x:Name="CursorOverlay" Visibility="Collapsed" Stretch="Fill" />
                </Canvas>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3">
            <!-- Copia di file nella VM (M6): sotto lo schermo, mai sopra. -->
            <InfoBar x:Name="TransferInfo" Margin="12,8,12,8" IsOpen="False" IsClosable="True" Severity="Informational">
                <InfoBar.Content>
                    <ProgressBar x:Name="TransferProgress" Maximum="1" Margin="0,0,0,12" />
                </InfoBar.Content>
            </InfoBar>
            <InfoBar x:Name="RendererInfo" Margin="12" IsOpen="True" IsClosable="True"
                     Severity="Informational" Title="Renderer" />
        </StackPanel>
    </Grid>
</Window>
