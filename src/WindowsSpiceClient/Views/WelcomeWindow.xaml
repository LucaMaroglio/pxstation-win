<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsSpiceClient.Views.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" x:Uid="WelcomeTitleBar" Title="Benvenuto">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/app-64.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <StackPanel Grid.Row="1" Padding="32,8,32,28" Spacing="12" VerticalAlignment="Center">
            <Image Source="ms-appx:///Assets/app-256.png" Width="96" Height="96" />
            <TextBlock x:Name="AppNameText" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Uid="WelcomeText" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button x:Name="OpenButton" AutomationProperties.LabeledBy="{Binding ElementName=OpenButtonText}" Style="{StaticResource AccentButtonStyle}" Click="OnOpen">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                        <TextBlock x:Name="OpenButtonText" x:Uid="OpenConnectionFileButton" />
                    </StackPanel>
                </Button>
                <Button x:Name="VmListButton" AutomationProperties.LabeledBy="{Binding ElementName=VmListButtonText}" Click="OnVirtualMachines">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                        <TextBlock x:Name="VmListButtonText" x:Uid="VirtualMachinesButton" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Uid="WelcomeDropHint" HorizontalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
