<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsSpiceClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Windows Spice Client">

    <!-- Mica è impostata dal codice solo se supportata; altrimenti resta lo sfondo del tema. -->
    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra del titolo integrata (ExtendsContentIntoTitleBar). -->
        <Grid x:Name="TitleBar" Height="48" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/app-64.png" Width="16" Height="16" />
                <TextBlock Text="Windows Spice Client" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Superficie Direct3D 11: qui verrà disegnato lo schermo della VM (M3). -->
        <SwapChainPanel x:Name="DisplayPanel" Grid.Row="1" Margin="12,0,12,0" />

        <InfoBar x:Name="RendererInfo" Grid.Row="2" Margin="12" IsOpen="True" IsClosable="False"
                 Severity="Informational" Title="Renderer" />
    </Grid>
</Window>
