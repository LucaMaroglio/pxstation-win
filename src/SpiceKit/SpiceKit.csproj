<Project Sdk="Microsoft.NET.Sdk">
  <!-- Protocollo SPICE, codec, .vv e Proxmox. Nessuna dipendenza da WinUI o Direct3D (AGENTS.md §3). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SpiceKit</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- CS1591: i membri ovvi (ReadU8, Count…) non richiedono un commento; i tipi e l'API pubblica
         significativa sì. CA1720: "pointer" è il termine del protocollo SPICE (offset nel messaggio). -->
    <NoWarn>$(NoWarn);CS1591;CA1720</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SpiceKit.Tests" />
  </ItemGroup>
</Project>
